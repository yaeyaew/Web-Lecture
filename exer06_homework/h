  box.innerHTML = '';

  specialBox.innerHTML = '';

  const key = date.slice(5);

  const year = Number(date.slice(0,4));

  const special = getSpecialDays(year)[key];

  if (special) {

    const specialCard = document.createElement('div');

    specialCard.className = 'special-day';

    specialCard.textContent =
      `${special.icon} ${special.name}`;

    specialBox.appendChild(specialCard);

  }

  const events = schedules.filter(s => s.date === date);

  if (!events.length) {

    box.innerHTML =
      '<div class="notice">이 날짜에는 등록된 일정이 없습니다.</div>';

  }

  events.forEach(event => {

    const card = document.createElement('div');

    card.className = 'event';

    card.style.borderLeftColor = event.color || '#f3a6c8';

    card.innerHTML = `

      <div class="event-title">
        ${escapeHTML(event.title)}
      </div>

      <p>⏰ 시간: ${escapeHTML(event.time || '미정')}</p>

      <p>📍 장소: ${escapeHTML(event.place || '미정')}</p>

      <p>
        📝 내용:<br>
        ${escapeHTML(event.description || '내용 없음').replace(/\n/g,'<br>')}
      </p>

      <button class="danger"
        onclick="deleteSchedule('${event.id}')">
        🗑️ 일정 삭제
      </button>

    `;

    box.appendChild(card);

  });

  showPage('dayDetailPage');

}


// ===============================
// 일정 삭제
// ===============================

function deleteSchedule(id) {

  if (!confirm('이 일정을 삭제할까요?')) return;

  schedules = schedules.filter(s => s.id !== id);

  saveData();

  openDayDetail(selectedDate);

}


// ===============================
// 처음 실행
// ===============================

updateRequestCount();
updatePaymentCount();

</script>

