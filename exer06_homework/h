<textarea id="personalMessage" rows="4"
placeholder="메세지를 입력해 주세요."></textarea>


<!-- 유료서비스 -->

<div class="service-area">

<h2>💎 유료결제 선택 💎</h2>
<p class="subtitle">특별 서비스를 선택해 보세요 ✨</p>

<div class="service-card">
<label>
<input type="checkbox" class="personal-service"
id="personalSmile" onchange="serviceChanged()">
<span> 특별미소</span>
<span class="price">무료</span>
</label>
<p>주의! 기분따라 차별지급</p>
</div>

<div class="service-card">
<label>
<input type="checkbox" class="personal-service"
id="personalPriority" onchange="serviceChanged()">
<span>👑 데이트 우선예약</span>
<span class="price">유료</span>
</label>
<p>데이트 신청 우선 검토 요청</p>
<div id="personalPriorityPrice" class="other-input">
<label>금액 (최소 10,000원)</label>
<input type="number" id="personalPriorityAmount"
min="10000" step="1000" placeholder="금액 입력">
</div>
</div>

<div class="service-card">
<label>
<input type="checkbox" class="personal-service"
id="personalPass" onchange="serviceChanged()">
<span>💰 까방권 1회</span>
<span class="price">유료</span>
</label>
<p>실수 시 용서 기회 1회 제공</p>
<div id="personalPassPrice" class="other-input">
<label>금액 (최소 10,000원)</label>
<input type="number" id="personalPassAmount"
min="10000" step="1000" placeholder="금액 입력">
</div>
</div>



<label class="none-option">
<input type="checkbox" id="personalNone"
onchange="selectNone()">
선택 안함
</label>

<div id="personalPayment" class="payment-notice">
💳 <strong>후불결제입니다.</strong><br>
이용 후 입금해 주세요. ♡(확인함)♡
</div>

</div>

<button onclick="submitRequest()">💌 데이트 신청하기</button>
<button class="back" onclick="showPage('home')">← 처음으로</button>

</div>


<!-- 비즈니스 신청 -->

<div id="business" class="page">

<h1>비즈니스 업무</h1>
<p class="subtitle">비즈니스 미팅을 신청해 보세요.</p>

<label>인원</label>
<input type="number" id="businessPeople"
min="1" placeholder="인원수를 입력해 주세요">

<label>날짜 (연도 제외)</label>
<input type="text" id="businessDate"
placeholder="예: 11월 25일">

<label>장소</label>
<input type="text" id="businessPlace"
placeholder="장소를 입력해 주세요">

<label>무슨 업무인가요? 💼</label>
<textarea id="businessWork" rows="5"
placeholder="업무 내용을 입력해 주세요."></textarea>

<button class="business-btn" onclick="submitBusiness()">
💌 비즈니스 신청하기
</button>

<button class="back" onclick="showPage('home')">← 처음으로</button>

</div>


<!-- 관리자 대시보드 -->

<div id="dashboard" class="page">

<div class="admin-header">
<h1>👑 Yeji Admin</h1>
<p>관리자 전용 페이지</p>
</div>

<div class="admin-menu">

<button onclick="openCalendar()">
<span>📅</span>캘린더
</button>

<button onclick="openRequests()">
<span>📩</span>요청
<b id="requestCount"></b>
</button>

<button onclick="openAddSchedule()">
<span>➕</span>일정 추가
</button>

<button onclick="openPayments()">
<span>💳</span>결제관리
