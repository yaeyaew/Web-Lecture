// ===============================

function acceptRequest(id) {

  const r = requests.find(item => item.id === id);

  if (!r) return;

  if (
    r.status === '수락' &&
    schedules.some(s => s.requestId === id)
  ) {

    alert('이미 수락되어 캘린더에 등록된 요청입니다.');

    return;

  }

  if (!confirm('이 신청을 수락하고 캘린더에 등록할까요?')) {
    return;
  }

  const reply = document.getElementById('reply-' + id).value;
  const color = document.getElementById('color-' + id).value;

  r.status = '수락';
  r.reply = reply;

  schedules.push({

    id:uid(),
    date:r.date,

    title:r.type === '개인'
      ? `${r.name}님과 데이트 💗`
      : '비즈니스 미팅 💼',

    time:r.time || '',
    place:r.place,

    description:r.type === '개인'

      ? `신청자: ${r.name}\n식사: ${r.food}\n메시지: ${r.message}\n서비스: ${(r.services || []).join(', ')}\n예지의 답변: ${reply}`

      : `인원: ${r.people}\n업무: ${r.work}\n예지의 답변: ${reply}`,

    requestId:r.id,
    color

  });

  saveData();

  renderRequests();

  updateRequestCount();

  alert('수락되었습니다! 캘린더에 일정이 등록됐어요. 💗');

}


// ===============================
// 거절
// ===============================

function rejectRequest(id) {

  const r = requests.find(item => item.id === id);

  if (!r) return;

  if (!confirm('이 신청을 거절할까요?')) return;

  r.status = '거절';

  r.reply = document.getElementById('reply-' + id).value;

  saveData();

  renderRequests();

  updateRequestCount();

}


// ===============================
// 요청 삭제
// ===============================

function deleteRequest(id) {

  if (!confirm('이 요청을 삭제할까요?')) return;

  requests = requests.filter(r => r.id !== id);

  saveData();

  renderRequests();

  updateRequestCount();

}


