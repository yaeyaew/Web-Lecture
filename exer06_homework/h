class="other-input" placeholder="장소 입력">

<label>식사 메뉴 🍽️</label>
<select id="personalFood"
onchange="showOther('personalFood','personalFoodOther')">
<option>스시</option>
<option>햄버거</option>
<option>피자</option>
<option>샐러드</option>
<option>국밥</option>
<option>마라탕</option>
<option>기타</option>
</select>

<input id="personalFoodOther"
class="other-input" placeholder="음식 입력">

