<option value="#f3a6c8">🌸 핑크</option>
<option value="#b9a5e8">💜 보라</option>
<option value="#91c5ed">💙 하늘색</option>
<option value="#f5d27c">💛 노랑</option>
<option value="#9dcfa9">💚 초록</option>
