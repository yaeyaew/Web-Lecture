<!-- 날짜별 상세 일정 -->

<div id="dayDetailPage" class="page">

<h1>📌 일정 상세</h1>
<h2 id="detailDate"></h2>

<div id="detailSpecial"></div>
<div id="detailEvents"></div>

<button class="back" onclick="openCalendar()">
← 캘린더
</button>

</div>

</div>


<script>

// ===============================
// 데이터 저장
// ===============================

let requests = JSON.parse(localStorage.getItem('yejiRequests') || '[]');
let schedules = JSON.parse(localStorage.getItem('yejiSchedules') || '[]');
let payments = JSON.parse(localStorage.getItem('yejiPayments') || '[]');

function saveData() {
  localStorage.setItem('yejiRequests', JSON.stringify(requests));
  localStorage.setItem('yejiSchedules', JSON.stringify(schedules));
  localStorage.setItem('yejiPayments', JSON.stringify(payments));
}

function uid() {
  return Date.now().toString() + Math.random().toString(36).slice(2,7);
}


// ===============================
// 화면 이동
// ===============================

function showPage(page) {
  document.querySelectorAll('.page').forEach(p => {
    p.classList.remove('active');
  });

  document.getElementById(page).classList.add('active');
}


// ===============================
// 관리자 로그인
// ===============================

function login() {

  const pw = document.getElementById('adminPassword').value;

  if (pw === '321110') {

    document.getElementById('adminPassword').value = '';

    updateRequestCount();
    updatePaymentCount();

    showPage('dashboard');

  } else {

    alert('비밀번호가 올바르지 않습니다.');

  }
}

function logout() {
  showPage('home');
}


// ===============================
// 기타 입력창
// ===============================

function showOther(selectId,inputId) {

  const select = document.getElementById(selectId);
  const input = document.getElementById(inputId);

  input.style.display = select.value === '기타' ? 'block' : 'none';

}


// ===============================
// 유료서비스
// ===============================

function serviceChanged() {

  const selected = document.querySelectorAll('.personal-service:checked');
  const none = document.getElementById('personalNone');

  if (selected.length > 0) none.checked = false;

  document.getElementById('personalPayment').style.display =
    selected.length > 0 ? 'block' : 'none';

  document.getElementById('personalPassPrice').style.display =
    document.getElementById('personalPass').checked ? 'block' : 'none';

  document.getElementById('personalPriorityPrice').style.display =
    document.getElementById('personalPriority').checked ? 'block' : 'none';

}

function selectNone() {

  if (!document.getElementById('personalNone').checked) return;

  document.querySelectorAll('.personal-service').forEach(item => {
    item.checked = false;
  });

  document.getElementById('personalPassPrice').style.display = 'none';
  document.getElementById('personalPriorityPrice').style.display = 'none';

  document.getElementById('personalPassAmount').value = '';
