let calendarDate = new Date();
let selectedDate = '';

function changeMonth(amount) {

  calendarDate.setDate(1);

  calendarDate.setMonth(calendarDate.getMonth() + amount);

  renderCalendar();

}

function renderCalendar() {

  const year = calendarDate.getFullYear();
  const month = calendarDate.getMonth();

  document.getElementById('monthTitle').textContent =
    `${year}년 ${month+1}월`;

  const grid = document.getElementById('calendarGrid');

  grid.innerHTML = '';

  ['일','월','화','수','목','금','토'].forEach(day => {

    const el = document.createElement('div');

    el.className = 'weekday';

    el.textContent = day;

    grid.appendChild(el);

  });

  const first = new Date(year,month,1).getDay();

  const last = new Date(year,month+1,0).getDate();

  const today = new Date();

  const todayText =
    `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;

  const specialDays = getSpecialDays(year);

  for (let i=0; i<first; i++) {

    const empty = document.createElement('div');

    empty.className = 'day empty';

    grid.appendChild(empty);

  }

  for (let day=1; day<=last; day++) {

    const date =
      `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;

    const key =
      `${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;

    const events = schedules.filter(s => s.date === date);

    const special = specialDays[key];

    const cell = document.createElement('div');

    cell.className = 'day';

    if (date === todayText) cell.classList.add('today');

    if (date === selectedDate) cell.classList.add('selected');

    const number = document.createElement('div');

    number.textContent = day;

    cell.appendChild(number);

    if (special) {

      const label = document.createElement('small');

      label.textContent = special.icon + ' ' + special.name;

      label.className =
        special.type === 'birthday'
          ? 'birthday-label'
          : 'holiday-label';

      cell.appendChild(label);

    }

    if (events.length) {

      const count = document.createElement('small');

      count.className = 'count';

      count.textContent = `● ${events.length}개 일정`;

      cell.appendChild(count);

      events.slice(0,2).forEach(event => {

        const eventLabel = document.createElement('small');

        eventLabel.textContent = event.title;

        eventLabel.style.background = event.color || '#f3a6c8';

        eventLabel.style.color = '#59434d';

        eventLabel.style.borderRadius = '5px';

        eventLabel.style.padding = '2px';

        cell.appendChild(eventLabel);

      });

    }

    cell.onclick = () => selectDay(date);

    grid.appendChild(cell);

  }

}


